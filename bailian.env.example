# Copy these values into the cloud server environment. Do not commit real secrets.
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_REGION=cn-beijing
B2T_BAILIAN_MODEL=qwen3-asr-flash-filetrans
B2T_BAILIAN_STORAGE=temporary

# Optional: only needed when B2T_BAILIAN_STORAGE=oss.
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_BUCKET=
# OSS_REGION=cn-beijing
# OSS_ENDPOINT=
# OSS_PREFIX=bili2text/audio

# Optional recognition tuning. The defaults follow Bailian's Qwen3 ASR example.
B2T_BAILIAN_ENABLE_ITN=false
B2T_BAILIAN_ENABLE_WORDS=true
